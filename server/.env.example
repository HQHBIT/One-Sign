# --- Server ---
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string-for-production
APPROVAL_WINDOW_MS=3600000
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL ---
# If DB_NAME does not exist, the server will CREATE DATABASE it on first run.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=signflow
# Optional: connect via Unix socket instead of TCP (overrides host/port when set)
# DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# --- SendGrid ---
# Leave SENDGRID_API_KEY blank to log emails in the DB without sending.
# Set it to enable real delivery through SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@hqhb.in
SENDGRID_FROM_NAME=HQHB SignFlow

# --- oneAccess SSO ---
# Leave ONEACCESS_API_BASE_URL / FRONTEND_URL / APP_SLUG blank to disable SSO
# entirely (login falls back to the local password form). Fill them to offer
# "Sign in with oneAccess". Values below are UAT; use the prod hosts in prod.
ONEACCESS_API_BASE_URL=https://uat-oneaccess.umooriqtesadiyah.org/api
ONEACCESS_FRONTEND_URL=https://uat-oneaccess.umooriqtesadiyah.org
ONEACCESS_APP_SLUG=members-portal-uat
ONEACCESS_REDIRECT_URL=
ONEACCESS_APP_ID=
# Backend-only M2M credential (shown once at issuance) — never ship to the browser.
ONEACCESS_CLIENT_ID=
ONEACCESS_CLIENT_SECRET=
# RS256 public key for local token verification. Either drop the PEM at this path,
# or leave the file absent and it will be fetched once from GET /api/public-key.
ONEACCESS_PUBLIC_KEY_PATH=./keys/oneaccess-public.pem
ONEACCESS_ACCESS_TOKEN_TTL=15m

# Cutover switch: keep password login ON until oneAccess SSO is verified working,
# then set to false to make SignFlow oneAccess-only. Default (unset) = enabled.
AUTH_LOCAL_LOGIN_ENABLED=true
