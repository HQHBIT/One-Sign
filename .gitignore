node_modules/
dist/
.env
server/.env
server/uploads/documents/*
server/uploads/signatures/*
server/uploads/signed/*
!server/uploads/documents/.gitkeep
!server/uploads/signatures/.gitkeep
!server/uploads/signed/.gitkeep
server/uploads/issues/*
server/uploads/voicenotes/*
!server/uploads/issues/.gitkeep
!server/uploads/voicenotes/.gitkeep

# Any copy of a box .env, whatever the suffix — they hold real keys.
server/.env.*
server/.env-*
.DS_Store
*.log
.vite
client/public/pdf.worker.min.js

# oneAccess public key cache (fetched at runtime)
server/keys/

# Locally generated CONFIDENTIAL_KEY, en route to the password manager.
# Must never be committed — it decrypts every confidential document.
confidential-key.txt

# Ad-hoc API scratch scripts. These get written with real credentials in the
# request body while poking at a running server — never commit them.
/test.js

# Claude Code local machine config + agent worktrees (a full second checkout).
.claude/worktrees/
.claude/launch.json
.claude/settings.json

# Word lock files left behind while a .docx is open.
~$*.docx
